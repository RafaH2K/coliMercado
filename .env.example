PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/colimamerrcado
JWT_SECRET=change-me-to-a-long-random-string
# Uno o varios orígenes separados por coma, sin espacios ni barra final:
CORS_ORIGIN=http://localhost:5173,https://tu-app.vercel.app
# La URL real a la que deben apuntar los links que manda el backend (checkout,
# reset de contraseña). Si la omites, se usa el primer valor de CORS_ORIGIN —
# en producción, con localhost también en esa lista, PONLA explícita o los
# pagos van a redirigir a localhost.
FRONTEND_URL=https://tu-app.vercel.app
# URL pública del propio backend (para el notification_url de los webhooks
# de Mercado Pago — MP la llama server-to-server, tiene que ser alcanzable
# desde internet, nunca localhost).
BACKEND_URL=https://tu-backend.up.railway.app

# Storage de imágenes (logos, productos, servicios) — Project Settings > API en Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me-service-role-key
# Nombre del bucket creado en Storage (debe existir y ser público)
SUPABASE_BUCKET=uploads

# Cobro de suscripciones de plan (Mercol -> negocio). Developers > API keys en Stripe.
STRIPE_SECRET_KEY=sk_test_change-me
# Developers > Webhooks > tu endpoint, después de crearlo
STRIPE_WEBHOOK_SECRET=whsec_change-me

# Checkout real: cada negocio conecta su cuenta de Mercado Pago (OAuth) y el
# cobro de productos/anticipos de citas cae directo ahí, no a esta cuenta —
# ver Developers > Tus integraciones en Mercado Pago, modelo "Marketplace".
MERCADOPAGO_CLIENT_ID=change-me
MERCADOPAGO_CLIENT_SECRET=change-me
# Debe coincidir EXACTO con el configurado en la app de Mercado Pago:
MERCADOPAGO_REDIRECT_URI=https://tu-backend.up.railway.app/api/mercadopago/callback
# 32 bytes en base64 — generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MERCADOPAGO_TOKEN_KEY=change-me
# Access Token de PRODUCCIÓN de tu propia cuenta de Mercado Pago (Developers >
# Tus integraciones > tu app > Credenciales de producción) — distinto del
# access_token de cada negocio conectado. Se usa para consultar el estado de
# un pago (GET /v1/payments) tanto al confirmar desde el navegador como desde
# el webhook, antes de saber a qué negocio pertenece.
MERCADOPAGO_ACCESS_TOKEN=change-me
# Clave de firma de los webhooks (Developers > Tus integraciones > tu app >
# Webhooks) — DISTINTA del client_secret de OAuth de arriba.
MERCADOPAGO_WEBHOOK_SECRET=change-me
