PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/colimamerrcado
JWT_SECRET=change-me-to-a-long-random-string
# Uno o varios orígenes separados por coma, sin espacios ni barra final:
CORS_ORIGIN=http://localhost:5173,https://tu-app.vercel.app

# Storage de imágenes (logos, productos, servicios) — Project Settings > API en Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me-service-role-key
# Nombre del bucket creado en Storage (debe existir y ser público)
SUPABASE_BUCKET=uploads
